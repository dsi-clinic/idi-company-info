# PermID API Configuration
# Get your API key from: https://permid.org
PERMID_API_KEY=your_permid_api_key_here

# GeoNames Username
# Register at: http://www.geonames.org/login
GEONAMES_USER=your_geonames_username_here

# Data Directory Paths (customize these to your local paths)
# These are the HOST paths that will be mapped into the container
WATCH_DIR=./data/watch
OUTPUT_DIR=./data/output
ARCHIVE_DIR=./data/archive
