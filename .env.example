# PermID API Configuration
# Get your API key from: https://permid.org
PERMID_API_KEY=your_permid_api_key_here

# GeoNames Username
# Register at: http://www.geonames.org/login
GEONAMES_USER=your_geonames_username_here

# Data Directory Paths (customize these to your local paths)
# These are the HOST paths that will be mapped into the container
WATCH_DIR=./data/watch
OUTPUT_DIR=./data/output
ARCHIVE_DIR=./data/archive

# Pipeline Configuration
# Number of investors to process per batch (default: 5000)
BATCH_SIZE=5000
# Re-query company info older than N days (default: 30)
THRESHOLD_DAYS=30

# Schedule Configuration
# Cron format: "second minute hour day month weekday"
# Examples:
#   Daily at 2 AM:      "0 0 2 * * *"
#   Daily at 12:30 PM:  "0 30 12 * * *"
#   Every 12 hours:     "0 0 */12 * * *"
#   Every Monday at 1AM: "0 0 1 * * 1"
SCHEDULE=0 0 2 * * *
