# IDI Company Information Pipeline Configuration
# Copy this file to .env and fill in your values

# Required: API Credentials
PERMID_API_KEY=your-permid-api-key-here
GEONAMES_USER=your-geonames-username-here

# Input Configuration
INPUT_FILE_PATH=./data/input/investors.parquet

# Pipeline Mode: cik (CIK-based Entity Search) or record (ticker-based Record Match)
PIPELINE_TYPE=cik

# Output Configuration
OUTPUT_DIR=./data/output
LOG_DIR=./logs

# Processing Parameters
BATCH_SIZE=5000
THRESHOLD_DAYS=30

# Scheduler Configuration (cron format: second minute hour day month weekday)
# Default: 2 AM daily
SCHEDULE=0 0 2 * * *
