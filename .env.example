# IDI Company Information Pipeline Configuration
# Copy this file to .env and fill in your values

# Optional: Override image URI (defaults to GHCR when unset)
# ORCHESTRATOR_IMAGE=ghcr.io/dsi-clinic/idi-company-info-orchestrator:latest

# Required: API Credentials
PERMID_API_KEY=your-permid-api-key-here
GEONAMES_USER=your-geonames-username-here

# Input files — each identifier type reads from its own parquet file
# CIK input must have columns: investor_name, investor_cik
INPUT_FILE_CIK=./data/input/investors_cik.parquet
# CUSIP input must have columns: issuer_name, security_cusip, stock_ticker
INPUT_FILE_CUSIP=./data/input/securities_cusip.parquet

# Output Configuration
OUTPUT_DIR=./data/output  # Makefile, local runs
OUTPUT_DIR_ORCHESTRATOR=/data/output  # For docker-compose: s3:// URL for buffered files
OUTPUT_MOUNT_SOURCE=./data/output  # For docker-compose: local path to mount for output volume

# Local path to mount for log volume
LOG_DIR=./logs

# AWS region (required when CloudWatch logs are enabled; boto3 uses this for all AWS clients)
AWS_REGION=us-east-2

# CloudWatch logging: set to true when running in Docker on EC2 (metadata may be unreachable)
CLOUDWATCH_LOGS_ENABLED=false

# Processing Parameters (shared across CIK and CUSIP pipelines)
BUFFER_SIZE=500
THRESHOLD_DAYS=30
MATCH_SCORE_THRESHOLD=1  # 1 = require 100% match score (both pipelines use Record Match)

# CIK pipeline (Record Match)
BATCH_SIZE_CIK=2450

# CUSIP pipeline (Record Match)
BATCH_SIZE_CUSIP=2450

# Scheduler Configuration (cron format: second minute hour day month weekday)
# CIK track: 2:00 AM daily
SCHEDULE_CIK=0 0 2 * * *
# CUSIP track: 2:30 AM daily
SCHEDULE_CUSIP=0 30 2 * * *
