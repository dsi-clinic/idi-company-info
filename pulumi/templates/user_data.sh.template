#!/bin/bash
set -e

# Update system
yum update -y

# Install Docker, cronie (crontab), and AWS CLI
yum install -y docker cronie
systemctl enable docker crond
systemctl start docker crond

# Add ec2-user to docker group
usermod -aG docker ec2-user

# Install Docker Compose
curl -L "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose
chmod +x /usr/local/bin/docker-compose

# Create app directory (no git clone - use ECR images)
APP_DIR=/home/ec2-user/idi-company-info
mkdir -p $APP_DIR
cd $APP_DIR

# Create output/log dirs
mkdir -p /home/ec2-user/data/output /home/ec2-user/data/logs

# Retrieve secret values
{SECRET_RETRIEVAL}

# Create .env from env.example structure
mkdir -p /home/ec2-user/data/input
cat > .env << ENVFILE_EOF
# IDI Company Information Pipeline Configuration (matches .env.example)
PERMID_API_KEY=$PERMID_API_KEY
GEONAMES_USER=$GEONAMES_USER

# ECR image URI (set by Pulumi)
ORCHESTRATOR_IMAGE={ORCHESTRATOR_IMAGE}

# Input files — S3 URLs (orchestrator reads directly; docker-compose uses /tmp dummy mount by default)
INPUT_FILE_ORCHESTRATOR_CIK=s3://idi-dev-processor-s3/input/shareholder_tracker_release_20251218.parquet
INPUT_FILE_ORCHESTRATOR_CUSIP=s3://idi-dev-processor-s3/input/shareholder_tracker_release_20251218.parquet
INPUT_FILE_ORCHESTRATOR_CIK_MATCH=s3://idi-dev-processor-s3/input/shareholder_tracker_release_20251218.parquet
INPUT_FILE_ORCHESTRATOR_TICKER=s3://idi-dev-processor-s3/input/shareholder_tracker_release_20251218.parquet

# Output Configuration (local path or s3:// URL for buffered files)
OUTPUT_DIR_ORCHESTRATOR={OUTPUT_DIR}
LOG_DIR=/home/ec2-user/data/logs

# CloudWatch logging (enables when metadata unreachable from Docker)
CLOUDWATCH_LOGS_ENABLED=true

# Processing Parameters
BUFFER_SIZE=500
THRESHOLD_DAYS=30
BATCH_SIZE_CIK=2450
BATCH_SIZE_CUSIP=2450
BATCH_SIZE_CIK_MATCH=2450
BATCH_SIZE_TICKER=2450
MATCH_SCORE_THRESHOLD=1

ENVFILE_EOF

# Create docker-compose.yml (orchestrator service defs for pull_and_run; no long-running services)
cat > docker-compose.yml << '{COMPOSE_DELIM}'
{COMPOSE_CONTENT}
{COMPOSE_DELIM}

# Pull-and-run script for host cron (ECR login + pull + run per scheduled job)
cat > $APP_DIR/pull_and_run.sh << 'PULL_RUN_EOF'
{PULL_AND_RUN_SCRIPT}
PULL_RUN_EOF
chmod +x $APP_DIR/pull_and_run.sh

# Set ownership
chown -R ec2-user:ec2-user /home/ec2-user/idi-company-info /home/ec2-user/data

# Host cron: pull latest orchestrator image, then run
su - ec2-user -c "(crontab -l 2>/dev/null | grep -v pull_and_run; echo '{CRON_CIK} $APP_DIR/pull_and_run.sh orchestrator-cik'; echo '{CRON_CUSIP} $APP_DIR/pull_and_run.sh orchestrator-cusip') | crontab -"

echo "Setup complete!"
